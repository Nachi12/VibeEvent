# JobShield Server Environment Variables

# Anthropic Claude API Key (Required for AI analysis mode)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supported Sonnet Model (e.g. claude-3-7-sonnet-20250219 or claude-3-5-sonnet-20241022)
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# Server Port
PORT=5001

# Allowed Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
